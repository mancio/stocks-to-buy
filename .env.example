# Copy this file to `.env` and fill in your values.
FINNHUB_API_KEY=
NEAR_THRESHOLD_PCT=5.0

# Buy-side demand provider: derived | databento | alpaca | tiingo | none
# `derived` is free, needs no key, and is the only one that covers EU tickers.
DEMAND_PROVIDER=derived
# Only needed for DEMAND_PROVIDER=databento.
# https://databento.com/signup — new accounts get $125 of free historical credits
DATABENTO_API_KEY=
DATABENTO_DATASET=XNAS.ITCH
DATABENTO_SCHEMA=bbo-1m
